<Window x:Class="HarAnalyzerV2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HAR Analyzer V2"
        Icon="pack://application:,,,/HARIco.ico"
        Height="750"
        Width="1200"
        MinHeight="600"
        MinWidth="900"
        WindowStartupLocation="CenterScreen">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===================================================== -->
        <!-- TOP TOOLBAR                                           -->
        <!-- ===================================================== -->

        <Border Grid.Row="0"
                Background="#F3F3F3"
                BorderBrush="#D0D0D0"
                BorderThickness="0,0,0,1"
                Padding="10">

            <StackPanel Orientation="Horizontal">

                <Button x:Name="OpenHarButton"
                        Content="Open HAR"
                        Width="100"
                        Height="32"
                        Margin="0,0,10,0"
                        ToolTip="Open a HAR file"
                        Click="OpenHar_Click"/>

                <Button x:Name="ConvertSazButton"
                        Content="SAZ → HAR"
                        Width="110"
                        Height="32"
                        Margin="0,0,10,0"
                        ToolTip="Convert a Fiddler SAZ file to HAR"
                        Click="ConvertSaz_Click"/>

                <Button x:Name="ZipHarButton"
                        Content="Zip HAR"
                        Width="100"
                        Height="32"
                        Margin="0,0,10,0"
                        ToolTip="Compress the currently loaded HAR file"
                        Click="ZipHar_Click"/>

                <Button x:Name="AboutButton"
                        Content="About"
                        Width="100"
                        Height="32"
                        ToolTip="About HAR Analyzer V2"
                        Click="About_Click"/>

            </StackPanel>

        </Border>

        <!-- ===================================================== -->
        <!-- MAIN CONTENT                                          -->
        <!-- ===================================================== -->

        <Grid Grid.Row="1"
              Margin="10">

            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="250"/>
            </Grid.RowDefinitions>

            <!-- ================================================= -->
            <!-- HAR REQUEST GRID                                  -->
            <!-- ================================================= -->

            <DataGrid x:Name="HarGrid"
                      Grid.Row="0"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      SelectionChanged="HarGrid_SelectionChanged">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="Method"
                                        Binding="{Binding Method}"
                                        Width="80"/>

                    <DataGridTextColumn Header="Status"
                                        Binding="{Binding Status}"
                                        Width="80"/>

                    <DataGridTextColumn Header="Host"
                                        Binding="{Binding Host}"
                                        Width="200"/>

                    <DataGridTextColumn Header="URL"
                                        Binding="{Binding Url}"
                                        Width="*"/>

                    <DataGridTextColumn Header="Time"
                                        Binding="{Binding Time}"
                                        Width="100"/>

                </DataGrid.Columns>

            </DataGrid>

            <!-- ================================================= -->
            <!-- REQUEST / RESPONSE / BODY                         -->
            <!-- ================================================= -->

            <TabControl Grid.Row="1"
                        Margin="0,10,0,0">

                <TabItem Header="Request">

                    <TextBox x:Name="RequestText"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             AcceptsTab="True"
                             TextWrapping="NoWrap"
                             FontFamily="Consolas"
                             FontSize="13"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"/>

                </TabItem>

                <TabItem Header="Response">

                    <TextBox x:Name="ResponseText"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             AcceptsTab="True"
                             TextWrapping="NoWrap"
                             FontFamily="Consolas"
                             FontSize="13"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"/>

                </TabItem>

                <TabItem Header="Body">

                    <TextBox x:Name="BodyText"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             AcceptsTab="True"
                             TextWrapping="NoWrap"
                             FontFamily="Consolas"
                             FontSize="13"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"/>

                </TabItem>

            </TabControl>

        </Grid>

        <!-- ===================================================== -->
        <!-- STATUS BAR                                            -->
        <!-- ===================================================== -->

        <StatusBar Grid.Row="2">

            <StatusBarItem>

                <TextBlock x:Name="StatusText"
                           Text="Ready"/>

            </StatusBarItem>

        </StatusBar>

    </Grid>

</Window>