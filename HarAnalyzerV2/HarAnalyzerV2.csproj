<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows7.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>

    <AssemblyTitle>HAR Analyzer V2 By Andrei Emilian Rachita</AssemblyTitle>

    <!-- Icon embedded in the generated EXE -->
    <ApplicationIcon>HARIco.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Makes the icon available to WPF -->
    <Resource Include="HARIco.ico" />
  </ItemGroup>

</Project>